#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "../zmk-helpers/include/zmk-helpers/helper.h"
#include "../zmk-helpers/include/zmk-helpers/key-labels/42.h"
#include "../zmk-helpers/include/zmk-helpers/unicode-chars/french.dtsi"
#include "./keymap_french.h"

#define ______ &trans
#define xxxxxx &none

#define DEF 0
#define NUM 1
#define SYM 2
#define ADJ 3
#define DLD 4
#define DRD 5
#define DLG 6
#define DRG 7
#define DLC 8
#define DRC 9
#define DLA 10

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left-hand keys
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right-hand keys
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                                  // thumb keys

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

// accentuated chars
ZMK_BEHAVIOR(a_circ, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_CIRC &kp FR_A>;
)

ZMK_BEHAVIOR(ht_a_circ, hold_tap,
       flavor = "tap-preferred";
       tapping-term-ms = <175>;
       global-quick-tap;
       bindings = <&a_circ>, <&kp>;
)

ZMK_BEHAVIOR(a_diae, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_DIAE &kp FR_A>;
)

