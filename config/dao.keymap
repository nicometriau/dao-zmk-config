// open / close brackets
ZMK_BEHAVIOR(anglebrackets, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_LABK>, <&kp FR_RABK>, <&kp LEFT_ARROW>;
)
ZMK_BEHAVIOR(parentheses, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_LPRN>, <&kp FR_RPRN>, <&kp LEFT_ARROW>;
)
ZMK_BEHAVIOR(squarebrackets, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_LBRC>, <&kp FR_RBRC>, <&kp LEFT_ARROW>;
)
ZMK_BEHAVIOR(curlybrackets, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_LCBR>, <&kp FR_RCBR>, <&kp LEFT_ARROW>;
)
ZMK_BEHAVIOR(backticks, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp RA(N7)>, <&kp RA(N7)>, <&kp LEFT_ARROW>;
)
ZMK_BEHAVIOR(dbquotes, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_DQUO>, <&kp FR_DQUO>, <&kp LEFT_ARROW>;
)
ZMK_BEHAVIOR(sgquotes, macro,
	wait-ms = <0>;
	tap-ms = <5>;
	bindings = <&kp FR_QUOT>, <&kp FR_QUOT>, <&kp LEFT_ARROW>;
)

// Lower , Upper ? Hold ° Double #
ZMK_BEHAVIOR(custo_comm, tap_dance,
    tapping-term-ms = <175>;
    bindings = <&mt FR_DEG FR_COMM>, <&kp FR_HASH>;
)

// Lower ; Upper . Hold & Double @
ZMK_BEHAVIOR(custo_scln, tap_dance,
    tapping-term-ms = <175>;
    bindings = <&mt FR_AMPR FR_SCLN>, <&kp FR_AT>;
)

// Lower : Upper / Hold | Double \ (backslash)
ZMK_BEHAVIOR(custo_coln, tap_dance,
    tapping-term-ms = <175>;
    bindings = <&mt FR_PIPE FR_COLN>, <&kp FR_BSLS>;
)

// Lower ! Upper § Hold _ Double ~
ZMK_BEHAVIOR(custo_exlm, tap_dance,
    tapping-term-ms = <175>;
    bindings = <&mt FR_SECT FR_EXLM>, <&kp FR_TILD>;
)

// home-row mods
ZMK_HOLD_TAP(lh_pht,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)
ZMK_HOLD_TAP(rh_pht,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)
ZMK_HOLD_TAP(lh_pht_anglebrackets,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&anglebrackets>;
)
ZMK_HOLD_TAP(lh_pht_squarebrackets,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&squarebrackets>;
)
ZMK_HOLD_TAP(lh_pht_sgquotes,
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&sgquotes>;
)

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &extra_keys_transform;
    };
};

ZMK_LAYER(default_layer,
    &kp FR_SUP2   &lt DLD FR_Q        &lt DLG FR_W        &lt DLC FR_F         &lt DLA FR_P         &kp FR_B        &kp FR_J      &kp FR_L             &lt DRC FR_U         &lt DRG FR_Y        &custo_exlm         &none
    &kp FR_QUOT   &lh_pht LGUI FR_A   &lh_pht LALT FR_R   &lh_pht LCTRL FR_S   &lh_pht LSHFT FR_T   &kp FR_G        &kp FR_K      &rh_pht RSHFT FR_N   &rh_pht RCTRL FR_E   &rh_pht RALT FR_I   &rh_pht RGUI FR_O   &none
    &none         &kp FR_Z            &kp FR_X            &mt FR_CCED FR_C     &kp FR_D             &kp FR_V        &kp FR_M      &kp FR_H             &custo_comm          &custo_scln         &custo_coln         &none
                                                          &lt SYM TAB          &mt LSHFT BSPC       &lt NUM DEL     &lt NUM RET   &mt RSHFT SPACE      &lt SYM ESC
)

ZMK_LAYER(number_layer,
    &none  &none  &kp FR_EQL   &kp FR_PLUS  &kp FR_MINS  &kp FR_EURO     &none     &kp FR_7  &kp FR_8  &kp FR_9  &none  &none
    &none  &none  &kp FR_PERC  &kp FR_ASTR  &kp FR_SLSH  &kp FR_DLR      &none     &kp FR_4  &kp FR_5  &kp FR_6  &none  &none
    &none  &none  &kp FR_CURR  &kp FR_DOT   &kp FR_COMM  &kp FR_PND      &none     &kp FR_1  &kp FR_2  &kp FR_3  &none  &none
                               &lt ADJ TAB  &trans       &trans          &trans    &kp FR_0  &lt ADJ ESC
)

ZMK_LAYER(symbol_layer,
    &none  &kp C_VOL_UP   &kp C_BRI_UP                  &parentheses                    &dbquotes                 &none            &kp SLCK      &kp HOME  &kp UP_ARROW     &kp PG_UP  &none  &none
    &none  &kp C_MUTE     &lh_pht_anglebrackets LALT 0  &lh_pht_squarebrackets LCTRL 0  &lh_pht_sgquotes LSHFT 0  &none            &kp CLCK      &kp LEFT  &kp DOWN         &kp RIGHT  &none  &none
    &none  &kp C_VOL_DN   &kp C_BRI_DN                  &curlybrackets                  &backticks                &none            &none         &kp END   &kp PRINTSCREEN  &kp PG_DN  &none  &none
                                                        &trans                          &trans                    &lt ADJ DEL      &lt ADJ RET   &trans    &trans
)

ZMK_LAYER(adjust_layer,
    &none  &none  &none  &none   &none   &none     &none   &none   &none  &none  &none  &none
    &none  &none  &none  &none   &none   &none     &none   &none   &none  &none  &none  &none
    &none  &none  &none  &none   &none   &none     &none   &none   &none  &none  &none  &none
                         &trans  &none   &trans    &trans  &none   &trans
)

